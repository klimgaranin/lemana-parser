# LemanapPRO Parser — пример .env
# Скопируй в .env: copy .env.example .env
# .env не коммитить: там могут быть cookie и токены.


# ============================================================
# 1. Вход и Excel
# ============================================================

# URL первой страницы каталога. Значение: полный https://lemanapro.ru/catalogue/... URL.
LEMANA_CATALOG_URL="https://lemanapro.ru/catalogue/svetilniki-dlya-vannoy/?deliveryType=%D0%A1%D0%B0%D0%BC%D0%BE%D0%B2%D1%8B%D0%B2%D0%BE%D0%B7+%D0%B2+%D0%BC%D0%B0%D0%B3%D0%B0%D0%B7%D0%B8%D0%BD%D0%B5"

# Папка для Excel-выгрузок. Значение: путь к папке.
LEMANA_OUTPUT_DIR="output"

# Базовое имя Excel-файла. Значение: имя с расширением .xlsx.
LEMANA_OUTPUT_FILENAME="lemana_result.xlsx"

# Лимит товаров из каталога. Значение: целое число >= 1.
LEMANA_MAX_PRODUCTS=100000

# Лимит артикулов из --articles-file. Значение: 0 без лимита или целое число >= 1.
LEMANA_MAX_ARTICLES=0

# Предохранитель по страницам каталога. Значение: целое число >= 1.
LEMANA_MAX_PAGES_SAFETY=8000


# ============================================================
# 2. Источник данных
# ============================================================

# Источник данных. Значения: api-fallback (рекомендуется), api, html.
LEMANA_DATA_SOURCE="api-fallback"


# ============================================================
# 3. API сайта
# ============================================================

# Размер API-батча. Значение: 1..100. Для больших списков осторожно: 30.
LEMANA_API_PAGE_SIZE=60

# Параллельность API-страниц каталога. Значение: 1..8. Стабильно: 1, тест ускорения: 2.
LEMANA_API_CATALOG_CONCURRENCY=1

# Пауза между API-батчами артикулов, сек. Значение: число >= 0. Для больших списков: 3.0.
LEMANA_API_ARTICLES_SLEEP=0.0

# Режим артикулов. Значения: strict-then-relaxed (рекомендуется), relaxed.
LEMANA_API_ARTICLES_MODE="strict-then-relaxed"

# Название региона для логов. Значение: текст.
LEMANA_API_REGION_NAME="Москва, Московская область"

# Резервные regionId для добора api_data_missing через GAS. Значение: пусто или список через запятую.
LEMANA_API_FALLBACK_REGION_IDS=""


# ============================================================
# 4. GAS proxy, экспериментально для каталога и артикулов
# ============================================================

# Транспорт API для каталога и --articles/--articles-file. Значения: local, gas, gas-fallback.
LEMANA_API_TRANSPORT="local"

# URL опубликованного Apps Script Web App. Значение: https://script.google.com/macros/s/.../exec.
LEMANA_GAS_PROXY_URL=""

# Токен GAS proxy. Значение: пусто или тот же токен, что в Script Properties LEMANA_PROXY_TOKEN.
LEMANA_GAS_PROXY_TOKEN=""


# ============================================================
# 5. Cookie
# ============================================================

# Проверять cookie перед запуском. Значения: true/false.
LEMANA_COOKIE_PREFLIGHT=true

# В preflight также проверять HTML-карточку товара. Значения: true/false.
LEMANA_COOKIE_PREFLIGHT_PRODUCT=true

# Автоматически обновлять cookie через Chrome CDP/Playwright. Значения: true/false.
LEMANA_COOKIE_AUTO_REFRESH=true

# Cookie вручную, если автообновление не помогло. Значение держать в кавычках.
LEMANA_COOKIE=""


# ============================================================
# 6. HTTP и TLS
# ============================================================

# Таймаут страницы каталога, сек. Значение: целое число >= 1.
LEMANA_CATALOG_TIMEOUT=25

# Таймаут карточки товара, сек. Значение: целое число >= 1.
LEMANA_PRODUCT_TIMEOUT=30

# Максимум retry обычных HTTP-ошибок. Значение: целое число >= 1.
LEMANA_MAX_RETRIES=4

# Базовая пауза retry, сек. Значение: число > 0.
LEMANA_RETRY_BACKOFF=0.6

# Браузерный профиль curl_cffi. Значение: обычно chrome.
LEMANA_BROWSER_IMPERSONATE="chrome"

# Проверять HTTPS-сертификаты. Значения: true/false. Рекомендуется true.
LEMANA_SSL_VERIFY=true


# ============================================================
# 7. Параллельность
# ============================================================

# Параллельность страниц каталога. Значение: целое число >= 1.
LEMANA_CATALOG_CONCURRENCY=8

# Параллельность карточек HTML fallback. Значение: целое число >= 1. Стабильно: 2.
LEMANA_PRODUCT_CONCURRENCY=2


# ============================================================
# 8. HTML fallback и антибот-стабильность
# ============================================================

# Стартовая пауза между батчами карточек, сек. Стабильно: 4.0.
LEMANA_PRODUCT_BATCH_SLEEP=4.0

# Максимальная адаптивная пауза между батчами карточек, сек.
LEMANA_PRODUCT_MAX_BATCH_SLEEP=10.0

# Включить адаптивное замедление при 403/429. Значения: true/false.
LEMANA_PRODUCT_ADAPTIVE_THROTTLE=true

# Сколько стабильных батчей ждать перед ускорением. Значение: целое число >= 1.
LEMANA_PRODUCT_RECOVERY_BATCHES=6

# Максимальный активный batch карточек. Стабильно: 2.
LEMANA_PRODUCT_MAX_ACTIVE_BATCH=2

# Минимальная recovery-пауза после антибота, сек. Стабильно: 4.0.
LEMANA_PRODUCT_MIN_RECOVERY_SLEEP=4.0

# Cooldown после антибот-сигнала, сек. Стабильно: 15.0.
LEMANA_PRODUCT_PRESSURE_COOLDOWN=15.0

# Откладывать 403/429 карточки на медленный повтор. Значения: true/false.
LEMANA_PRODUCT_DEFERRED_RETRY=true

# Количество медленных раундов отложенных карточек. Значение: целое число >= 1.
LEMANA_PRODUCT_DEFERRED_ROUNDS=3

# Пауза между отложенными карточками, сек.
LEMANA_PRODUCT_DEFERRED_SLEEP=6.0

# Общая случайная пауза HTML-запросов, мс. Значения: целые числа, MIN <= MAX.
LEMANA_MIN_SLEEP_MS=1500
LEMANA_MAX_SLEEP_MS=3500
